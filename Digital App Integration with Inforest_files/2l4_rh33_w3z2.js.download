;!function(){try { var e="undefined"!=typeof globalThis?globalThis:"undefined"!=typeof global?global:"undefined"!=typeof window?window:"undefined"!=typeof self?self:{},n=(new e.Error).stack;n&&((e._debugIds|| (e._debugIds={}))[n]="ebd032d0-a48f-b8a6-830d-a3d23bd59446")}catch(e){}}();
(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,5779993,(e,a,o)=>{a.exports=JSON.parse('{"Add to chat":"Agregar al chat","Anonymous":"Anónimo","Ask Grok":"Pregúntale a Grok","Ask anything":"Pregunta lo que quieras","Back":"Volver","Cancel":"Cancelar","Close":"Cerrar","Close search":"Cerrar búsqueda","Contact Support":"Contacta al soporte técnico","Content Moderated":"Contenido moderado. Prueba una idea diferente.","Content is empty":"Contenido vacío","Continue":"Continuar","Copied!":"¡Copiado!","Copy":"Copiar","Could not load document.":"No se pudo cargar el documento.","Create share link":"Crear enlace para compartir","Deep Search: Browsed URLs":"Deep Search: URLs consultadas","Documents":"Documentos","Download":"Descargar","Download Asset":"Descargar recurso","Enter prompt here":"Introduce el mensaje aquí","Explain":"Explicar","Explain this":"Explica esto","Failed to load image":"No se pudo cargar la imagen","Files":"Archivos","Generate more images like this":"Generar más imágenes como esta","Go to page":"Ir a la página","Good afternoon, {{username}}.":"Buenas tardes, {{username}}.","Good evening, {{username}}.":"Buenas noches, {{username}}.","Good morning, {{username}}.":"Buenos días, {{username}}.","Grok was unable to finish replying.description":"Por favor, intenta de nuevo más tarde o usa un modelo diferente.","Grok was unable to finish replying.errorMessage":"Grok no pudo terminar de responder.","Grok was unable to reply.description":"Por favor, intenta regenerar una respuesta.","Grok was unable to reply.errorMessage":"Grok no pudo responder a tu último mensaje.","Hello":"Hola","Home page":"Página de inicio","Loading Older Messages":"Cargando mensajes anteriores","Loading text…":"Cargando texto…","Mobile":"Móvil","Next result":"Siguiente resultado","No content available.":"No hay contenido disponible.","No text content available.":"No hay contenido de texto disponible.","Open in New Tab":"Abrir en una pestaña nueva","Open in new tab":"Abrir en una pestaña nueva","Original image to edit":"Imagen original a editar","Page":"Página","Page number":"Número de página","Prefer this response":"Prefiero esta respuesta","Previous result":"Resultado anterior","Problem playing audio":"Problema al reproducir audio","Quick Answer":"Respuesta rápida","Quote":"Citar","Rate Limit Reached.description":"Límite de consulta alcanzado para {{modelName}}. El límite se restablece en {{time}}.","Reconnecting...":"Reconectando...","Refresh":"Actualizar","Reload":"Volver a cargar","Response letter":"Respuesta {{letter}}","Retry":"Reintentar","Return to Home":"Volver al inicio","Save":"Guardar","Search":"Buscar","Search Results":"Resultados de la búsqueda","Share conversation with team":"Compartir conversación con el equipo","Skip Selection":"Omitir selección","Something went wrong when loading the document.":"Algo salió mal al cargar el documento.","Source":"Fuente","Sources":"Fuentes","Switch to Default Chat":"Cambiar a chat normal","Switch to Private Chat":"Cambiar a chat privado","There was an error":"Ocurrió un error","Think Harder":"Razonamiento más profundo","Thinking-content-override":"Razonando...","This will help make Grok better.":"Esto ayudará a mejorar a Grok.","Thoughts":"Razonamiento","Try again or ":"Intenta de nuevo o ","Unauthenticated.description":"Por favor, inicia sesión o actualiza la página","Unauthenticated.errorMessage":"No se puede confirmar la autenticidad del usuario.","Update share link":"Actualizar enlace compartido","Waiting-for-thinking":"Esperando a que todas las respuestas terminen de pensar","Welcome to Grok.":"Bienvenido a Grok.","Which response do you prefer?":"¿Cuál respuesta prefieres?","Wide":"Amplia","Zoom in":"Acercar","Zoom out":"Alejar","anon-chat-not-found-error.cta":"Iniciar un nuevo chat","anon-chat-not-found-error.description":"Inicia sesión para solicitar acceso","anon-chat-not-found-error.sign-in":"Iniciar sesión","anon-chat-not-found-error.title":"Este chat es privado","app-grant.already-granted":"{{connector}} ya otorgado","app-grant.already-granted-badge":"Ya concedido","app-grant.already-granted-v2":"{{connector}} ya otorgado — selecciona para volver a aprobar","app-grant.approve":"Permitir {{connector}}","app-grant.approve-multi":"Permitir {{count}} conectores","app-grant.body":"{{app}} está pidiendo usar tu conexión de {{connector}} para que los espectadores que han conectado {{connector}} puedan usar esas herramientas en la aplicación. Puedes revocarlo más tarde.","app-grant.body-multi":"{{app}} solicita usar {{count}} de tus conexiones para que los espectadores que las hayan conectado puedan usar esas herramientas en la aplicación. Puedes revocar esto más tarde.","app-grant.body-v2":"{{app}} quiere tu conexión {{connector}} para que los espectadores conectados puedan usar esas herramientas. Puedes revocarla más tarde.","app-grant.deny":"Ahora no","app-grant.deselect-all":"Deseleccionar todo","app-grant.error":"No se pudo otorgar acceso. Inténtalo de nuevo.","app-grant.granted-pill":"{{connector}} ✓","app-grant.owner-data-label":"Los espectadores verán datos de tu {{connector}} (datos del propietario).","app-grant.pick-connector":"Elegir una conexión","app-grant.runs-as":"Se ejecuta como {{principal}}.","app-grant.select-all":"Seleccionar todas","app-grant.success":"Acceso otorgado. Tu aplicación puede usar {{connector}}.","app-grant.this-app":"Esta aplicación","app-grant.title":"¿Permitir acceso al conector?","app-grant.tool-names-summary":"{{tools}}.","app-grant.viewer-data-label":"Cada espectador se conecta y ve sus propios datos de {{connector}}.","ask-user-question.answer":"Respuesta","ask-user-question.answers":"Respuestas","ask-user-question.custom-answer":"Respuesta personalizada","ask-user-question.dismiss":"Descartar pregunta","ask-user-question.done":"Listo","ask-user-question.next":"Siguiente","ask-user-question.no-answer":"(No se proporcionó respuesta)","ask-user-question.previous":"Pregunta anterior","ask-user-question.previous-button":"Anteriores","ask-user-question.question":"Pregunta","ask-user-question.questions":"Preguntas","ask-user-question.skip":"Omitir","ask-user-question.step":"{{current}} de {{total}}","asset-viewer.expand-image":"Ver imagen en pantalla completa","asset-viewer.expand-video":"Ver video en pantalla completa","asset-viewer.video":"Video","asset-viewer.video-load-error":"No se pudo reproducir este video.","audio-player.mute-button.label":"Silenciar","audio-player.pause-button.label":"Pausar","audio-player.play-button.label":"Reproducir","audio-player.seek-slider.label":"Buscar","audio-player.unmute-button.label":"Reactivar sonido","autocomplete_suggestion_copy.label":"Copiar al portapapeles","autocomplete_suggestion_copy.toast":"Copiado al portapapeles","background-tasks-tray.delete-failed.toast":"No se pudo eliminar la tarea programada","background-tasks-tray.delete-scheduled-button.label":"Eliminar tarea programada","background-tasks-tray.kill-button.label":"Detener tarea","background-tasks-tray.kill-failed.toast":"No se pudo detener la tarea","background-tasks-tray.next-fire-soon.label":"pronto","background-tasks-tray.title":"Tareas de fondo","background-tasks-tray.toggle-button.label":"Alternar tareas de fondo","build-mode-hint.cta":"Cambiar","build-mode-hint.dismiss":"Descartar","build-mode-hint.subtitle":"El Modo de Construcción puede convertir esto en un sitio web, juego, aplicación o panel.","build-mode-hint.subtitle-short":"Convierte esto en un sitio web, juego o aplicación.","build-mode-hint.title":"Cambiar a Modo de Construcción","build-mode-hint.title-short":"Modo de Construcción","build-mode-starters.example.audio.audio-visualizer.label":"Visualizador de audio","build-mode-starters.example.audio.audio-visualizer.prompt":"Construye un visualizador de música que reacciona a la entrada del micrófono o a una pista cargada con barras animadas, modos circulares y temas de color. Incluye reproducir/pausa para archivos, control de sensibilidad y pantalla completa. Haz que la visualización sea fluida y los controles discretos.","build-mode-starters.example.audio.chord-player.label":"Reproductor de acordes","build-mode-starters.example.audio.chord-player.prompt":"Construye un reproductor de progresiones de acordes con un selector de escala o tonalidad, presets comunes de progresiones, patrones de rasgueo o arpegio y reproducción en bucle. Incluye control de tempo, acorde activo resaltado y la posibilidad de editar la secuencia de la progresión. Hazlo útil para la práctica de composición de canciones con una interfaz limpia de app de música.","build-mode-starters.example.audio.drum-machine.label":"Máquina de ritmos","build-mode-starters.example.audio.drum-machine.prompt":"Construye una máquina de batería con secuenciador de pasos con una cuadrícula de 16 pasos para bombo, snare, hats y percusión, además de control de tempo y reproducir/detener. Incluye limpiar patrón, aleatorizar, swing y resaltado visual de pasos mientras reproduce. Haz que la interfaz sea basada en cuadrícula, responsiva y satisfactoria al hacer clic.","build-mode-starters.example.audio.synth-keyboard.label":"Teclado sintetizador","build-mode-starters.example.audio.synth-keyboard.prompt":"Crea un teclado sintetizador jugable con teclas en pantalla, mapeo de teclado de computadora, selección de forma de onda y perillas de filtro y envolvente. Incluye cambio de octava, volumen y un osciloscopio o medidor de nivel simple. Haz que las teclas presionadas se iluminen y que el audio inicie solo después de un gesto del usuario.","build-mode-starters.example.audio.theremin.label":"Teremín","build-mode-starters.example.audio.theremin.prompt":"Construye un theremin controlado por ratón con el tono mapeado a X y el volumen a Y, además de elección de forma de onda y reverberación. Incluye una guía visual para el área de reproducción, alternador de silencio y una lectura simple del tono. Haz que el sonido sea expresivo y la interacción inmediatamente comprensible.","build-mode-starters.example.data-viz.network-graph.label":"Gráfico de red","build-mode-starters.example.data-viz.network-graph.prompt":"Construye un gráfico de red dirigido por fuerzas con nodos arrastrables, zoom y paneo, etiquetas de bordes y una caja de búsqueda que resalta los nodos que coinciden. Incluye datos de muestra para el gráfico, clic para inspeccionar los detalles del nodo y controles para recalentar o congelar la simulación. Haz que el lienzo ocupe toda la pantalla y sea óptimo en rendimiento.","build-mode-starters.example.data-viz.poll-app.label":"Aplicación de encuestas","build-mode-starters.example.data-viz.poll-app.prompt":"Construye una app de encuestas en vivo donde los usuarios pueden crear una pregunta con múltiples opciones, votar una vez y ver barras de resultados animadas que se actualizan en tiempo real con estado local. Incluye un contador de votos totales, etiquetas de porcentaje y la posibilidad de restablecer o iniciar una nueva encuesta. Hazla responsiva con estados claros de seleccionado y deshabilitado.","build-mode-starters.example.data-viz.revenue-dashboard.label":"Tablero de ingresos","build-mode-starters.example.data-viz.revenue-dashboard.prompt":"Construye un tablero interactivo de ingresos con filtros de rango de fechas, tarjetas KPI para ingresos, crecimiento y cancelación, y gráficos de tendencias que se actualizan con la selección. Incluye una tabla de desglose, tooltips al pasar el cursor y datos de muestra para que funcione sin conexión. Haz que el diseño sea responsivo con una estética de análisis limpia.","build-mode-starters.example.data-viz.world-map.label":"Mapa del mundo","build-mode-starters.example.data-viz.world-map.prompt":"Crea un mapa coroplético mundial que colorea los países según una métrica, con una leyenda, tooltips al pasar el cursor y un selector de métricas. Incluye datos de muestra, pan y zoom, y un panel lateral que muestra detalles para el país seleccionado. Haz que las interacciones sean fluidas y la jerarquía visual clara.","build-mode-starters.example.game.3d-maze.label":"Laberinto 3D","build-mode-starters.example.game.3d-maze.prompt":"Crea un laberinto 3D low-poly en primera persona con movimiento WASD, mirada con mouse y coleccionables dispersos a lo largo de los pasillos. Incluye un minimapa que revela los caminos explorados, un temporizador y una pantalla de victoria cuando se encuentra la salida. Haz que la colisión con las paredes se sienta sólida y mantén la estética limpia y juguetona.","build-mode-starters.example.game.endless-runner.label":"Corredor interminable","build-mode-starters.example.game.endless-runner.prompt":"Construye un corredor sin fin para navegador donde el jugador salta y se desliza pasando obstáculos procedurales que se vuelven más densos con el tiempo. Incluye salto con un toque o barra espaciadora, puntuación por combo, rampas de velocidad y un puntaje alto que se guarda en el almacenamiento local. Agrega una pantalla de fin de juego con reinicio y animaciones suaves para salto, aterrizaje y colisiones con obstáculos.","build-mode-starters.example.game.platformer.label":"Juego de plataformas","build-mode-starters.example.game.platformer.prompt":"Crea un juego de plataformas 2D con correr, saltar, doble salto, plataformas móviles, monedas y peligros. Incluye un sistema de puntos de control, un contador de monedas y una bandera de meta que termina el nivel. Haz que los controles sean responsivos con teclas de flecha o WASD, y agrega una selección de nivel simple o reinicio al morir.","build-mode-starters.example.game.space-shooter.label":"Shooter espacial","build-mode-starters.example.game.space-shooter.prompt":"Crea un shooter espacial de vista superior con oleadas de enemigos, disparos del jugador y power-ups para disparo múltiple, escudo y velocidad. Incluye vidas, seguimiento de puntuación, un tablero de récords y un menú de pausa. Agrega fondo de campo de estrellas con paralaje, destellos de disparo y movimiento suave de la nave con controles de teclado o puntero.","build-mode-starters.example.game.tower-defense.label":"Defensa de torres","build-mode-starters.example.game.tower-defense.prompt":"Construye un juego de defensa de torres con un camino para creeps, torres colocables y oro ganado por eliminaciones. Incluye múltiples tipos de torres con diferentes rangos y costos, progresión de oleadas y una ruta de mejoras para daño y tasa de disparo. Muestra vidas restantes, oro actual y una pantalla de juego terminado o victoria con reinicio.","build-mode-starters.example.generative.flow-field.label":"Campo de flujo","build-mode-starters.example.generative.flow-field.prompt":"Crea un generador de arte de campo de flujo con partículas a la deriva que siguen un campo de ruido, además de controles para velocidad, longitud de estela y paleta. Incluye un botón de aleatorizar semilla, pausa y exportación a PNG. Haz que el lienzo completo sea generativo y satisfactorio para ver cómo evoluciona.","build-mode-starters.example.generative.fractal-tree.label":"Árbol fractal","build-mode-starters.example.generative.fractal-tree.prompt":"Crea un árbol fractal generativo que crece con ángulo de ramificación ajustable, profundidad y longitud, además de un suave balanceo por el viento. Incluye un botón de regenerar, controles de paleta de colores y superposiciones opcionales de hojas o flores. Anima el crecimiento al cargar para que el árbol se sienta vivo.","build-mode-starters.example.generative.kaleidoscope.label":"Caleidoscopio","build-mode-starters.example.generative.kaleidoscope.prompt":"Crea un caleidoscopio que refleje el movimiento del puntero en patrones simétricos y coloridos con cantidad de segmentos y modos de color ajustables. Incluye una opción de congelar imagen, aleatorizar y exportar imagen. Mantén las animaciones fluidas y los controles lo suficientemente simples para jugar inmediatamente.","build-mode-starters.example.generative.mandelbrot-zoom.label":"Zoom de Mandelbrot","build-mode-starters.example.generative.mandelbrot-zoom.prompt":"Construye un explorador del fractal de Mandelbrot con clic para zoom, arrastrar para desplazar, coloreado suave y controles de iteración. Incluye ubicaciones interesantes predeterminadas, un botón de restablecer la vista y renderizado consciente del rendimiento. Haz que la interfaz sea mínima para que el fractal siga siendo el foco.","build-mode-starters.example.generative.particle-field.label":"Campo de partículas","build-mode-starters.example.generative.particle-field.prompt":"Construye un campo de partículas interactivo que se arremolina hacia el cursor con estelas, cambios de color y conteo de partículas y fuerza ajustables. Incluye un control de borrar/reiniciar, opciones de color de fondo y un botón para descargar captura de pantalla. Haz que las interacciones con el puntero se sientan inmediatas y visualmente ricas.","build-mode-starters.example.math.fourier-drawing.label":"Dibujo de Fourier","build-mode-starters.example.math.fourier-drawing.prompt":"Construye un juguete de serie de Fourier que redibuja una forma dibujada o predeterminada con epiciclos giratorios, cantidad de términos ajustable y velocidad de reproducción. Incluye modo de dibujar tu propia forma, reproducir/pausar y un rastro de la trayectoria reconstruida. Haz que los epiciclos sean visualmente claros y los controles simples.","build-mode-starters.example.math.function-grapher.label":"Graficador de funciones","build-mode-starters.example.math.function-grapher.prompt":"Construye un graficador de funciones interactivo que grafica una o más ecuaciones con zoom, pan, cuadrícula y una lectura de valores bajo el cursor. Incluye funciones de ejemplo, etiquetas de ejes y manejo de errores para entradas no válidas. Haz que el área de graficación sea grande y los controles secundarios pero claros.","build-mode-starters.example.math.prime-explorer.label":"Explorador de primos","build-mode-starters.example.math.prime-explorer.prompt":"Construye un explorador visual de números primos con una criba de Eratóstenes animada, enteros clicables y desglose de factores para números compuestos. Incluye controles de rango, reproducir/pausa para la animación y una lista de primos encontrados. Haz que la visualización sea educativa y fácil de seguir.","build-mode-starters.example.math.probability-lab.label":"Laboratorio de probabilidad","build-mode-starters.example.math.probability-lab.prompt":"Crea un simulador de probabilidades con modos de dados y moneda, conteos de ensayos configurables y un histograma en vivo de resultados que se actualiza conforme se ejecutan los ensayos. Incluye comparación con la probabilidad teórica, reinicio y control de velocidad para las animaciones. Hazlo útil para enseñar la intuición básica de probabilidad.","build-mode-starters.example.math.vector-field.label":"Campo vectorial","build-mode-starters.example.math.vector-field.prompt":"Construye un graficador de campos vectoriales con una ecuación editable para el campo, controles de densidad de flechas y líneas de flujo animadas o partículas. Incluye preajustes, reproducir/pausa y lectura al pasar el cursor de valores vectoriales. Mantén la interfaz de matemáticas accesible con retroalimentación visual inmediata.","build-mode-starters.example.productivity.budget-planner.label":"Planificador de presupuesto","build-mode-starters.example.productivity.budget-planner.prompt":"Construye un planificador de presupuesto con entradas de ingresos y gastos, desgloses por categoría, una meta de ahorro y un saldo restante en vivo. Incluye un gráfico simple de gastos por categoría y la posibilidad de editar o eliminar transacciones. Haz que los números sean fáciles de escanear con un diseño limpio de app financiera.","build-mode-starters.example.productivity.habit-tracker.label":"Rastreador de hábitos","build-mode-starters.example.productivity.habit-tracker.prompt":"Construye un rastreador de hábitos con marcas diarias, un calendario de rachas y estadísticas de completitud para cada hábito. Incluye agregar, editar o eliminar hábitos, codificación por colores y persistencia en el almacenamiento local. Haz que la vista semanal o mensual sea escaneable y motivadora.","build-mode-starters.example.productivity.kanban-board.label":"Tablero Kanban","build-mode-starters.example.productivity.kanban-board.prompt":"Construye un tablero kanban con columnas de Por hacer, En progreso y Hecho con tarjetas arrastrables. Incluye la posibilidad de agregar, editar y eliminar tarjetas con títulos y descripciones, además de conteo de tarjetas por columna. Persiste el estado del tablero en el almacenamiento local y agrega animaciones suaves al arrastrar.","build-mode-starters.example.productivity.notes-app.label":"Aplicación de notas","build-mode-starters.example.productivity.notes-app.prompt":"Construye una aplicación de notas con una lista en la barra lateral, edición de markdown en el panel principal, búsqueda instantánea y crear/eliminar notas. Incluye marcas de tiempo de última edición, persistencia de almacenamiento local y un alternador de vista previa para el markdown renderizado. Haz la navegación amigable con el teclado y una interfaz de escritura mínima y enfocada.","build-mode-starters.example.productivity.pomodoro-timer.label":"Temporizador Pomodoro","build-mode-starters.example.productivity.pomodoro-timer.prompt":"Crea un temporizador Pomodoro con duraciones de trabajo y descanso configurables, iniciar/pausar/reiniciar y una lista de tareas para la sesión actual. Incluye conteo de sesiones, sonido opcional al completarse y un anillo de progreso visual. Mantén el diseño enfocado y calmado con estados activos claros.","build-mode-starters.example.simulation.boids-flock.label":"Bandada de boids","build-mode-starters.example.simulation.boids-flock.prompt":"Crea una simulación de bandada de boids que se arremolinan con separación, alineación y cohesión, y se dispersan o evitan el cursor. Incluye deslizadores en vivo para el peso de cada regla, tamaño de población y velocidad. Haz que el lienzo sea de pantalla completa con controles legibles y movimiento en tiempo real fluido.","build-mode-starters.example.simulation.fluid-ripples.label":"Ondulaciones fluidas","build-mode-starters.example.simulation.fluid-ripples.prompt":"Construye una simulación interactiva de ondas en fluido que reacciona a arrastres de ratón o toque con ondas expansivas y amortiguación. Incluye controles para viscosidad, fuerza de onda y mapa de color, además de una acción para limpiar la superficie. Haz que el efecto sea de pantalla completa y sedoso con interacción continua.","build-mode-starters.example.simulation.game-of-life.label":"Juego de la vida","build-mode-starters.example.simulation.game-of-life.prompt":"Construye el Juego de la Vida de Conway con una cuadrícula pintable, reproducir/pausa, paso, control de velocidad y patrones preestablecidos como planeador y pistola de Gosper. Incluye limpiar, aleatorizar y contador de generaciones. Haz que pintar con el mouse sea fluido y la cuadrícula nítida en múltiples niveles de zoom.","build-mode-starters.example.simulation.gravity-sim.label":"Simulador de gravedad","build-mode-starters.example.simulation.gravity-sim.prompt":"Crea un simulador de gravedad orbital donde hagas clic y arrastres para lanzar planetas y observes cómo orbitan, se impulsan y colisionan. Incluye presets de masa, renderizado de estelas, control de escala de tiempo y un botón de limpiar. Mantén la física lo suficientemente estable para una coreografía de múltiples cuerpos satisfactoria.","build-mode-starters.example.simulation.physics-sandbox.label":"Sandbox de física","build-mode-starters.example.simulation.physics-sandbox.prompt":"Construye un patio de recreo de física 3D donde puedes soltar esferas, cajas y cilindros que se apilan, rebotan y se derrumban bajo la gravedad. Incluye herramientas para generar formas, limpiar el mundo, ajustar la gravedad y la restitución, y arrastrar cuerpos. Haz que las interacciones sean inmediatas con una barra de herramientas simple y una simulación estable.","build-mode-starters.example.three-d.3d-globe.label":"Globo 3D","build-mode-starters.example.three-d.3d-globe.prompt":"Construye un globo 3D rotatorio con marcadores de ubicación brillantes, arrastrar para girar y clic para enfocar un marcador. Incluye una lista de ubicaciones destacadas, iluminación ambiental suave y rotación automática que se pausa mientras el usuario interactúa. Haz que la escena ocupe toda la ventana con una atmósfera sutil y transiciones de cámara suaves.","build-mode-starters.example.three-d.product-viewer.label":"Visor de productos","build-mode-starters.example.three-d.product-viewer.prompt":"Construye un visor de productos en 3D que orbita un modelo de producto estilizado con controles de iluminación, rotación automática y variantes de material o color. Incluye zoom, un botón de restablecer la cámara y una interfaz limpia al estilo comercial alrededor del lienzo. Haz que las interacciones se sientan premium y responsivas en escritorio y móvil.","build-mode-starters.example.three-d.solar-system.label":"Sistema solar","build-mode-starters.example.three-d.solar-system.prompt":"Crea un sistema solar en 3D con planetas en órbita, velocidad de simulación ajustable, etiquetas y movimientos de cámara al hacer clic para enfocar. Incluye un control de pausa, estelas orbitales y paneles de información simples para cada planeta. Mantén la estética oscura y espacial con bucles de animación suaves.","build-mode-starters.example.three-d.starfield.label":"Campo de estrellas","build-mode-starters.example.three-d.starfield.prompt":"Crea un campo de estrellas 3D a velocidad warp que puedas dirigir con el mouse o puntero, con velocidad y densidad ajustables. Incluye un modo de impulso, desenfoque de movimiento sutil o estrellas con estelas, y controles en pantalla que no abarroten la vista. Hazlo inmersivo y extremadamente fluido a 60fps.","build-mode-starters.example.three-d.terrain-flyover.label":"Sobrevuelo de terreno","build-mode-starters.example.three-d.terrain-flyover.prompt":"Construye un terreno 3D low-poly que puedes sobrevolar con mirada de ratón y empuje de teclado, además de un alternador de wireframe y coloración basada en la altura. Incluye colisión simple con el suelo, un mini HUD para altitud y velocidad, y opciones de iluminación de día/noche. Mantén el estilo artístico estilizado y legible.","build-mode-starters.example.tools.color-palette.label":"Paleta de colores","build-mode-starters.example.tools.color-palette.prompt":"Construye un generador de paleta de colores con cinco muestras, bloqueo por color, aleatorizar y valores hex, RGB y HSL copiables. Incluye comprobaciones de contraste contra colores de texto y exportación de la paleta como variables CSS. Haz que los atajos de teclado y el clic para copiar se sientan rápidos.","build-mode-starters.example.tools.photo-booth.label":"Cabina de fotos","build-mode-starters.example.tools.photo-booth.prompt":"Construye una cabina de fotos con cámara web con vista previa en vivo, preajustes de filtros, una cuenta regresiva antes de capturar y descarga de instantáneas. Incluye manejo de permisos, una tira de galería de tomas recientes y voltear la cámara cuando esté disponible. Haz que la interfaz sea juguetona y responsiva con estados de cámara claros.","build-mode-starters.example.tools.pixel-art.label":"Arte en píxeles","build-mode-starters.example.tools.pixel-art.prompt":"Construye una herramienta de dibujo de pixel art con una cuadrícula redimensionable, paleta de colores, lápiz y borrador, herramienta de relleno, deshacer/rehacer y exportación a PNG. Incluye alternar la cuadrícula, limpiar el lienzo y una paleta limitada para un toque retro. Haz que el dibujo sea fluido con eventos de puntero y una barra de herramientas limpia.","build-mode-starters.example.tools.qr-generator.label":"Generador de QR","build-mode-starters.example.tools.qr-generator.prompt":"Crea un generador de código QR con una vista previa en vivo mientras escribes una URL o texto, opciones de color para primer plano y fondo, y control de tamaño. Incluye selección de nivel de corrección de errores y descarga en PNG. Mantén el diseño simple con retroalimentación instantánea y etiquetas de formulario accesibles.","build-mode-starters.example.website.bio-page.label":"Página de biografía","build-mode-starters.example.website.bio-page.prompt":"Crea una página de enlaces en biografía con un avatar circular, nombre mostrado, biografía corta y una pila vertical de botones de enlaces destacados. Incluye íconos sociales, animaciones sutiles al pasar el cursor y un alternador de tema entre claro y oscuro. Hazlo primero para móvil con un diseño pulido y moderno que funcione bien como enlace de aterrizaje personal.","build-mode-starters.example.website.event-page.label":"Página de evento","build-mode-starters.example.website.event-page.prompt":"Construye un sitio de evento de una página con un temporizador de cuenta regresiva, agenda del horario, tarjetas de oradores, marcador de mapa del lugar y un formulario de RSVP. Incluye niveles de tickets o mensajes de capacidad, retroalimentación de éxito después del RSVP y navegación adhesiva para cada sección. Hazlo responsivo con una estética vibrante y con marca del evento.","build-mode-starters.example.website.landing-page.label":"Página de aterrizaje","build-mode-starters.example.website.landing-page.prompt":"Construye una página de aterrizaje de producto SaaS con un hero impactante, propuesta de valor clara, cuadrícula de características, niveles de precios, testimonios y un formulario de suscripción por correo electrónico. Incluye navegación adhesiva, anclas de desplazamiento suave y un fuerte llamado a la acción a lo largo de la página. Hazla totalmente responsiva con un diseño limpio y orientado a la conversión.","build-mode-starters.example.website.portfolio.label":"Portafolio","build-mode-starters.example.website.portfolio.prompt":"Diseña un sitio de portafolio personal con tarjetas de proyectos, una sección acerca de, habilidades y un formulario de contacto. Incluye estados de hover en proyectos que revelen descripciones cortas, chips de filtro por categoría y un pie de página pulido. Hazlo responsivo con desplazamiento suave y un estilo visual moderno y editorial.","build-mode-starters.more":"Más ideas","button.make-video":"Crear video","chart.accuracy-warning":"Grok puede cometer errores. Siempre verifica las fuentes originales.","chart.download":"Descargar","chart.download.as-image":"Como Imagen","chart.download.as-spreadsheet":"Como Hoja de Cálculo","chart.failed-generation":"No se pudo generar el gráfico","chart.generating":"Generando gráfico","chart.try-again":"Intenta de nuevo","chat-column-toggle.collapse-label":"Contraer área de trabajo","chat-column-toggle.expand-label":"Expandir área de trabajo","chat-column-toggle.expand-label-v2":"Expandir","chat-disclaimer":"Grok puede cometer errores. Verifica la información importante.","chat-not-found-error.cta":"Iniciar un nuevo chat","chat-not-found-error.description":"Si esto fue un enlace que alguien compartió contigo, por favor pide al remitente que envíe explícitamente un enlace compartido.","chat-not-found-error.title":"Chat no encontrado","chat-survey-standard-title":"¿Estás satisfecho con la respuesta de Grok?","chat-survey.close":"Cerrar","chat-survey.send-feedback":"Enviar comentarios","chat-survey.success.description":"Nos ayuda a que Grok sea mejor para ti","chat-survey.success.title":"Gracias por tus comentarios","chat-survey.thumbs_down":"No me gusta","chat-survey.thumbs_up":"Me gusta","chat-top-nav.view-count-tooltip":"Visualizaciones de la conversación compartida","citation.executed-code":"Código ejecutado","citation.sources-pill-code-exec-label":"Ver ejecuciones de código","clickwrapAgreement":"Al enviar un mensaje a Grok, acepta nuestros <terms>Términos</terms> y <policy>Política de Privacidad</policy>.","connector-keyword-upsell.cta":"Conectar","connector-keyword-upsell.dismiss":"Descartar","connector-keyword-upsell.subtitle.box":"Grok puede buscar archivos y leer tus documentos.","connector-keyword-upsell.subtitle.canva":"Grok puede crear, editar y administrar tus diseños.","connector-keyword-upsell.subtitle.default":"Grok puede buscar, leer y realizar acciones en tu nombre.","connector-keyword-upsell.subtitle.figma":"Grok puede buscar, leer y editar tus diseños.","connector-keyword-upsell.subtitle.github":"Grok puede buscar repositorios, leer código y administrar incidencias y solicitudes de extracción.","connector-keyword-upsell.subtitle.gmail":"Grok puede buscar, leer y redactar correos electrónicos para ti.","connector-keyword-upsell.subtitle.google-calendar":"Grok puede ver, crear y administrar tus eventos de calendario.","connector-keyword-upsell.subtitle.google-drive":"Grok puede buscar documentos y leer y escribir archivos para ti.","connector-keyword-upsell.subtitle.linear":"Grok puede buscar, crear y administrar tus incidencias y proyectos.","connector-keyword-upsell.subtitle.notion":"Grok puede buscar, leer y editar tus páginas.","connector-keyword-upsell.subtitle.outlook":"Grok puede buscar, leer y redactar correos electrónicos para ti.","connector-keyword-upsell.subtitle.slack":"Grok puede buscar, leer y enviar mensajes en tus canales.","connector-keyword-upsell.title":"Conectar {{name}} a Grok","connectors-upsell.connectors-subtitle":"Los conectores permiten a Grok interactuar con aplicaciones directamente en conversaciones.","connectors-upsell.connectors-title":"Los conectores ya están disponibles.","connectors-upsell.cta":"Conectar","connectors-upsell.dismiss":"Descartar","continued-conversation-title":"Continuación: {{title}}","conversation-load-failed-error.cta":"Reintentar","conversation-load-failed-error.description":"Algo salió mal al cargar este chat. Por favor, verifica tu conexión e intenta nuevamente.","conversation-load-failed-error.title":"No se pudo cargar esta conversación","conversation-loader.label":"Cargando conversación…","copy url for image":"Copiar enlace","create-report":"Crear informe","create-report-prompt":"Crear un informe","editor.queue-clear-warning":"Editar borrará los mensajes en cola","enterprise-onboarding.back":"Volver","enterprise-onboarding.cancel":"Cancelar","enterprise-onboarding.connect":"Conectar","enterprise-onboarding.connect-subtitle":"Grok puede conectarse a las aplicaciones de abajo para ayudar a entender tu trabajo y tomar acciones por ti.","enterprise-onboarding.connect-title":"Conectar aplicaciones a Grok","enterprise-onboarding.connected":"Conectado","enterprise-onboarding.connecting":"Conectando…","enterprise-onboarding.continue":"Continuar","enterprise-onboarding.finish":"Empezar a usar Grok","enterprise-onboarding.get-started":"Empezar","enterprise-onboarding.no-connectors":"Aún no hay conectores configurados por tu administrador.","enterprise-onboarding.no-prompts":"No hay instrucciones de demostración disponibles. ¡Puedes empezar a chatear inmediatamente!","enterprise-onboarding.prompts-subtitle":"Grok es capaz de entender e interactuar como tú.","enterprise-onboarding.prompts-title":"Deja que Grok lo haga por ti","enterprise-onboarding.skip":"Omitir","enterprise-onboarding.skip-all":"Omitir","enterprise-onboarding.step-progress":"Paso {{current}} de {{total}}","enterprise-onboarding.welcome-cta-business":"Se te ha concedido acceso a Grok Business.","enterprise-onboarding.welcome-cta-enterprise":"Se te ha concedido acceso a Grok Enterprise.","enterprise-onboarding.welcome-greeting":"Bienvenido/a {{orgName}}","errorMessage":"Error: {{error}}","exceljs.empty-sheet":"Hoja vacía","exceljs.showing-rows":"Mostrando {{shown}} de {{total}} filas","file-card.close-preview":"Cerrar vista previa","file-card.collapse":"Cerrar vista previa de {{fileName}}","file-card.collapse-label":"Contraer","file-card.download":"Descargar {{fileName}}","file-card.download-label":"Descargar","file-card.expand":"Abrir vista previa de {{fileName}}","file-card.expand-label":"Expandir","file-card.file":"Archivo","file-card.open":"Abrir {{fileName}}","file-card.preview-unavailable":"Vista previa no disponible","file-card.view-preview":"Ver vista previa","file-tree.delete":"Eliminar","file-tree.download":"Descargar","file-tree.download-empty-folder":"Esta carpeta no tiene archivos para descargar.","file-tree.download-failed":"No se pudo descargar {{name}}. Inténtalo de nuevo.","file-tree.download-folder-too-large":"Esta carpeta es demasiado grande para descargar aquí.","file-tree.download-zip":"Descargar como zip","file-tree.new-file":"Nuevo archivo","file-tree.new-folder":"Nueva carpeta","file-tree.rename":"Renombrar","file-tree.row-actions":"Acciones para {{name}}","filesystem.download-all":"Descargar todo","filesystem.empty":"Carpeta vacía","filesystem.empty-hint":"Los archivos creados durante esta sesión aparecerán aquí","filesystem.error":"Error al cargar archivos","filesystem.home":"Inicio","filesystem.loading":"Cargando...","filesystem.markdown-placeholder":"Escribe para editar...","filesystem.reconnecting":"Reconectando...","filesystem.reviving":"Reviviendo área de trabajo…","filesystem.save-failed":"No se pudo guardar {{fileName}}. Tus últimas ediciones no están guardadas.","filesystem.updated":"Actualizado {{time}}","filesystem.updated-ago":"Actualizado hace {{time}}","filesystem.workspace-inactive":"Área de trabajo inactiva","finance-connector-upsell.cta":"Añadir","finance-connector-upsell.description":"Conecta cuentas para administrar tus finanzas en el chat","finance-connector-upsell.description-mobile":"Conecta cuentas financieras.","finance-connector-upsell.dismiss":"Descartar","finance-connector-upsell.title":"Finanzas","free-usage-after-limit-banner.build.message":"Alcanzaste tu {{limit}} — sigue creando con la asignación gratuita o actualiza para límites más altos.","free-usage-after-limit-banner.chat.message":"Alcanzaste tu {{limit}} — sigue chateando con la asignación gratuita o actualiza para límites más altos.","free-usage-after-limit-banner.cta":"Mejora","free-usage-after-limit-banner.daily.limit":"límite diario","free-usage-after-limit-banner.dismiss":"Descartar","free-usage-after-limit-banner.generic.limit":"límite de uso","free-usage-after-limit-banner.imagine.message":"Alcanzaste tu {{limit}} — sigue generando con la asignación gratuita o actualiza para límites más altos.","free-usage-after-limit-banner.monthly.limit":"límite mensual","free-usage-after-limit-banner.voice.message":"Alcanzaste tu {{limit}} — sigue hablando con la asignación gratuita o actualiza para límites más altos.","free-usage-after-limit-banner.weekly.limit":"límite semanal","gateway-connection-banner.dismiss-button.label":"Descartar","gateway-connection-banner.generic":"Grok tiene problemas con su conexión en tiempo real. Los mensajes podrían no enviarse hasta que se restaure.","gateway-connection-banner.retry-button.label":"Reintentar","gateway-connection-banner.sign-in-button.label":"Iniciar sesión","gateway-connection-banner.testing-connection":"Se detectó un problema de red. Probando tu conexión…","gateway-connection-banner.unauthorized":"Tu sesión ha terminado. Inicia sesión nuevamente.","gateway-connection-banner.unreachable":"No se puede alcanzar a Grok en este momento. Verifica tu conexión a internet.","gateway-connection-banner.websocket-blocked":"Tu red o software de seguridad está bloqueando la conexión en tiempo real de Grok. Prueba con otra red, o pide a tu equipo de TI que permita conexiones WebSocket a {{host}}.","gateway-new-conversation-error.description":"La conexión falló. Inténtalo de nuevo.","gateway-new-conversation-error.error-code":"Código de error: {{errorCode}}","gateway-new-conversation-error.retry-button":"Inténtalo de nuevo","gateway-new-conversation-error.sign-in-button":"Iniciar Sesión","gateway-new-conversation-error.start-over-button":"Comenzar de nuevo","gateway-new-conversation-error.testing-connection":"Probando tu conexión…","gateway-new-conversation-error.title":"No se pudo iniciar la conversación","gateway-new-conversation-error.unauthorized":"Tu sesión ha terminado. Inicia sesión nuevamente.","gateway-new-conversation-error.unreachable":"Grok no se puede alcanzar en este momento. Verifica tu conexión a internet e inténtalo de nuevo.","gateway-new-conversation-error.unreachable-v2":"No se puede conectar con Grok. Comprueba tu conexión a internet.","gateway-new-conversation-error.websocket-blocked":"Tu red está bloqueando la conexión en tiempo real que necesita Grok. Esto puede suceder en VPNs, redes corporativas o de hotel, o con software de seguridad. Prueba una red diferente o pide a tu equipo de TI que permita conexiones WebSocket a {{host}}. No es un problema con tu cuenta.","gateway-new-conversation-error.websocket-blocked-v2":"Tu red está bloqueando Grok. Prueba con otra red o pide a TI que permita WebSockets a {{host}}.","generated-images-card.title":"Imágenes generadas","go to next sent message":"Siguiente mensaje","go to previously sent message":"Mensaje anterior","google-drive-picker.file-tab.all":"Todo","google-drive-picker.file-tab.owned-by-me":"De mi propiedad","google-drive-picker.folder.untitled":"Carpeta sin título","grok-bot-button.aria-label":"Abrir Grok Bot","grok-bot-button.download-aria-label":"Descargar Grok Bot","grok-bot-button.label":"Grok Bot","grok-bot-button.upgrade-aria-label":"Obtén Grok Bot con SuperGrok Heavy","grok-bot-button.upgrade-aria-label-v2":"Obtén Grok Bot con {{planName}}","grok-bot-post-purchase.close.aria-label":"Cerrar","grok-bot-post-purchase.description":"Compañeros de equipo con IA a los que puedes dar trabajo real. Los bots pueden iniciar sesión en tus herramientas, usarlas igual que tú y regresar con el trabajo terminado. Disponible exclusivamente para SuperGrok Heavy.","grok-bot-post-purchase.description-v2":"Compañeros de equipo con IA a los que puedes darles trabajo real. Los bots inician sesión en tus herramientas, las usan igual que tú y regresan con el trabajo terminado. Incluido con {{planName}}.","grok-bot-post-purchase.download-button.label":"Descargar","grok-bot-post-purchase.download-button.outlink-label":"Obtén Grok Bot","grok-bot-post-purchase.learn-more-button.label":"Más información","grok-bot-post-purchase.title":"Comienza a usar Grok Bot","grok-bot-post-purchase.wordmark":"Grok Bot","grok-bot-upsell.cta":"Descargar","grok-bot-upsell.cta-outlink":"Obtén Grok Bot","grok-bot-upsell.cta-upgrade":"Mejora","grok-bot-upsell.description":"Compañeros de equipo con IA a los que puedes dar trabajo real. Usan tus herramientas tal como tú lo haces.","grok-bot-upsell.description-mobile":"Compañeros de equipo con IA para trabajo real.","grok-bot-upsell.dismiss":"Descartar","grok-bot-upsell.title":"Conoce Grok Bot","grok-build-modal.badge":"Probar gratis","grok-build-modal.close":"Cerrar","grok-build-modal.copy-command":"Copiar comando de instalación","grok-build-modal.feature-grok-4-6-description":"Nuestro nuevo modelo, creado para tareas de codificación y de agentes, ahora es el predeterminado.","grok-build-modal.feature-grok-4-6-title":"Grok 4.6","grok-build-modal.feature-imagine-description":"Generar o editar imágenes y videos para tus sitios web y aplicaciones.","grok-build-modal.feature-imagine-title":"Imagine","grok-build-modal.feature-multi-agent-loops-title":"Bucles de agentes múltiples","grok-build-modal.feature-subagents-description":"Generar agentes paralelos en sus propias ventanas de contexto.","grok-build-modal.install-hint":"Copia y pega en la terminal para probar","grok-build-modal.install-platform":"Instalar plataforma","grok-build-modal.subtitle-grok-4-6-supergrok":"El agente de codificación que se ejecuta desde tu terminal, ahora impulsado por Grok 4.6 — nuestro nuevo modelo. Acceso anticipado para suscriptores de SuperGrok y X Premium+.","grok-build-modal.subtitle-grok-4-6-terminal