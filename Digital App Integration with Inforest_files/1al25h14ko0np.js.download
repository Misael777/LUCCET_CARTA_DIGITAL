iption:"Prices, sentiment, and catalysts for your watchlist every day.",iconName:"dollar-sign",categories:["finance"],cadence:"daily",timeOfDay:"14:00",instruction:"Give me the latest on $TSLA, $BTC, $NVDA, $PLTR, and $ETH: current price and day change, the news driving each move, overall sentiment, and any upcoming catalysts like earnings or product events. Flag anything unusual in volume or options activity."},{id:"email-auto-responder",title:"Email Auto-Responder",description:"Draft concise replies for important email threads each morning.",iconName:"mail",categories:["productivity"],cadence:"daily",timeOfDay:"09:00",instruction:"Review important unanswered email threads and draft concise, helpful replies. Prioritize messages that need a response today."},{id:"weekly-review",title:"Weekly Review",description:"Wrap the week: what you did, loose ends, and next priorities.",iconName:"clipboard-list",categories:["productivity"],cadence:"weekly",timeOfDay:"16:00",dayOfWeek:5,instruction:"Help me run a weekly review: summarize what I worked on this week based on my recent conversations, list open loose ends and unanswered questions, and propose my top three priorities for next week with a one-line rationale for each."},{id:"ai-news-digest",title:"AI News Digest",description:"Model releases, research, and funding that actually matter.",iconName:"cpu",categories:["news"],cadence:"daily",timeOfDay:"08:00",instruction:"Summarize the most important AI news from the last 24 hours: model releases, notable research papers, funding rounds, and policy changes. For each item add one sentence on why it matters. Skip minor product updates and rumors."},{id:"x-trends-digest",title:"X Trends Digest",description:"The five most interesting conversations on X right now.",iconName:"flame",categories:["news"],cadence:"daily",timeOfDay:"12:00",instruction:"Look at what’s trending on X right now and give me the five most interesting conversations: what happened, why it’s taking off, and the sharpest take you can find on each side of the debate."},{id:"competitor-watch",title:"Competitor Watch",description:"Weekly digest of competitor launches, pricing, and hires.",iconName:"glasses",categories:["research","news"],cadence:"weekly",timeOfDay:"09:00",dayOfWeek:1,instruction:"Track news about my key competitors from the past week: product launches, pricing changes, notable hires, funding, and press coverage. Note anything that should change how I position my own product. Start by asking me to list the companies if I haven’t already told you."},{id:"task-extractor",title:"Task Extractor",description:"Extract action items from recent messages and summarize next steps.",iconName:"sticky-note",categories:["productivity"],cadence:"daily",timeOfDay:"17:00",instruction:"Review my recent messages and notes, extract action items, and summarize next steps with owners and suggested priorities."},{id:"daily-planner",title:"Daily Planner",description:"A realistic plan for today with focus blocks and quick wins.",iconName:"calendar",categories:["productivity"],cadence:"daily",timeOfDay:"08:30",instruction:"Based on my recent conversations and anything I’ve told you I’m working on, draft a realistic plan for today: two or three deep-work blocks with concrete goals, a short list of quick wins, and one thing I should explicitly not spend time on today."},{id:"earnings-calendar",title:"Earnings Calendar",description:"Who reports this week, expectations, and what to watch.",iconName:"calendar",categories:["finance"],cadence:"weekly",timeOfDay:"08:00",dayOfWeek:1,instruction:"List the notable companies reporting earnings this week with dates and times, consensus expectations, and one thing to watch in each report. Flag the reports most likely to move the broader market."},{id:"portfolio-news",title:"Portfolio News Scan",description:"Only material news for your holdings — earnings, ratings, lawsuits.",iconName:"briefcase",categories:["finance"],cadence:"daily",timeOfDay:"16:30",instruction:"Scan for news affecting my holdings and summarize only material items: earnings, guidance changes, analyst rating moves, lawsuits, and major product or leadership news. Note the likely impact of each. Start by asking for my tickers if I haven’t shared them yet."},{id:"paper-watch",title:"Paper Watch",description:"The week’s most interesting research, explained in plain language.",iconName:"microscope",categories:["research"],cadence:"weekly",timeOfDay:"09:00",dayOfWeek:3,instruction:"Find the most interesting new research papers from this week in my field. For the top three, explain the core idea in plain language, why it matters, and one limitation to keep in mind. Ask me which field to track if I haven’t told you."},{id:"topic-deep-dive",title:"Weekend Deep Dive",description:"One briefing memo each week on a topic you’re following.",iconName:"lightbulb",categories:["research"],cadence:"weekly",timeOfDay:"10:00",dayOfWeek:6,instruction:"Pick the most important development from this week in a topic I’m following and go deep: background, what changed, competing viewpoints, and what to watch next. Write it like a briefing memo. Ask me which topic to follow if I haven’t picked one."},{id:"workout-coach",title:"Workout Coach",description:"A daily 45-minute session that rotates through the week.",iconName:"heart",categories:["lifestyle"],cadence:"daily",timeOfDay:"06:30",instruction:"Give me today’s workout, rotating between push, pull, legs, and recovery days through the week. List exercises with sets and reps, a ten-minute warm-up, and one mobility exercise. Keep the session around 45 minutes and note which day of the rotation this is."},{id:"meal-planner",title:"Meal Planner",description:"Seven weeknight dinners plus one consolidated grocery list.",iconName:"chef-hat",categories:["lifestyle"],cadence:"weekly",timeOfDay:"17:00",dayOfWeek:0,instruction:"Plan my dinners for the coming week: seven healthy recipes across a variety of cuisines, each under 45 minutes to cook, with rough calories per serving. Include a single consolidated grocery list organized by store section."},{id:"language-practice",title:"Language Practice",description:"A short daily lesson: vocabulary, one grammar point, translation.",iconName:"globe",categories:["lifestyle"],cadence:"daily",timeOfDay:"19:00",instruction:"Run a short practice session for the language I’m learning: five new words with example sentences, one grammar point with a quick exercise, and a short paragraph for me to translate. Ask me which language and level to use if I haven’t said."}],E=new Set(["email-auto-responder","x-trends-digest","competitor-watch"]);var P=e.i(5502390);let R={blue:"bg-[#1084fe] hover:bg-[#1084fe] active:bg-[#1084fe]",orange:"bg-[#ff6700] hover:bg-[#ff6700] active:bg-[#ff6700]",pink:"bg-[#ff309b] hover:bg-[#ff309b] active:bg-[#ff309b]",purple:"bg-[#9159fe] hover:bg-[#9159fe] active:bg-[#9159fe]"};function L(e){return e.name.trim().toLowerCase()}e.s(["TEMPLATE_CATEGORY_IDS",0,["all","news","productivity","finance","research","lifestyle"],"templateTileFill",0,function(e){return R[O[e]]},"useAutomationTemplateCatalog",0,function(){let e,t,r=(0,n.c)(5),{activeAutomations:a}=(0,P.useAutomations)(),i=(0,I.useIsGovernment)();r[0]!==a?(e=new Set(a.map(L)),r[0]=a,r[1]=e):e=r[1];let o=e;if(r[2]!==o||r[3]!==i){for(let e of(t={all:[],news:[],productivity:[],finance:[],research:[],lifestyle:[]},A)){if(i&&(E.has(e.id)||e.categories.includes("finance"))||o.has(e.title.trim().toLowerCase()))continue;let n={id:e.id,title:e.title,description:e.description,category:e.categories[0],draft:b({id:e.id,name:e.title,icon:`l:${e.iconName}:inherit`,cadence:e.cadence,timeOfDay:e.timeOfDay,dayOfWeek:e.dayOfWeek,instruction:e.instruction})};for(let r of(t.all.push(n),e.categories))t[r].push(n)}r[2]=o,r[3]=i,r[4]=t}else t=r[4];return t}],3556675);var F=e.i(6388359),W=e.i(7717717),z=e.i(7526360),B=e.i(8852326);e.i(379120);var U=e.i(710447),q=e.i(1334251),H=e.i(7957979),Y=e.i(90191